VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://localhost:54321

# Internal-tool auto-login. Set both to skip the login screen on every load.
# Leave blank to use the normal email/password login form.
VITE_AUTO_LOGIN_EMAIL=
VITE_AUTO_LOGIN_PASSWORD=

# AI feature flag. Hides every AI-flavored surface — ✨ Generate buttons on
# Script/Caption/Hashtags, the Kayan AI side panel, and the "Generate riff"
# button on top posts. Set to "true" or "1" to enable. Leave blank for V1.
VITE_AI_ENABLED=
